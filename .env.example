# FireCast AI Environment Configuration
# Copy this file to .env.local to configure live Supabase and external API credentials

# Supabase Project Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NASA FIRMS API (Configured as a Supabase Secret in Production)
# In Supabase dashboard: Settings > Edge Functions > Secrets > FIRMS_MAP_KEY
FIRMS_MAP_KEY=your_nasa_firms_map_key_here
